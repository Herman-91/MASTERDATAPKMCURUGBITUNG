function doGet(e) {
  var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  var data = sheet.getDataRange().getValues();
  var result = [];
  for (var i = 1; i < data.length; i++) {
    if(data[i][0] !== "") {
      result.push({
        id: String(data[i][0]),
        nama: String(data[i][1] || ''),
        kategori: String(data[i][2] || ''),
        linkLihat: String(data[i][3] || ''),
        type1: String(data[i][4] || 'NONE'),
        link1: String(data[i][5] || ''),
        typePdf: String(data[i][6] || 'NONE'),
        linkPdf: String(data[i][7] || '')
      });
    }
  }
  return ContentService.createTextOutput(JSON.stringify(result))
    .setMimeType(ContentService.MimeType.JSON);
}

function doPost(e) {
  try {
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    var body = JSON.parse(e.postData.contents);
    sheet.clear();
    sheet.appendRow(["No / ID", "Nama Dokument", "Kategori / Unit", "Link Lihat", "Type 1", "Link 1", "Type PDF", "Link PDF"]);
    if (Array.isArray(body)) {
      body.forEach(function(item, index) {
        sheet.appendRow([
          item.id || (index + 1),
          item.nama || '',
          item.kategori || '',
          item.linkLihat || '',
          item.type1 || 'NONE',
          item.link1 || '',
          item.typePdf || 'NONE',
          item.linkPdf || ''
        ]);
      });
    }
    return ContentService.createTextOutput(JSON.stringify({ status: "success" }))
      .setMimeType(ContentService.MimeType.JSON);
  } catch(err) {
    return ContentService.createTextOutput(JSON.stringify({ status: "error", message: err.toString() }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}</pre>
