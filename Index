            document.getElementById('inputNamaDoc').value = '';
            
            if (categories.includes(activeSheet)) {
                document.getElementById('inputKategoriDoc').value = activeSheet;
            } else if (categories.length > 0) {
                document.getElementById('inputKategoriDoc').value = categories[0];
            }

            document.getElementById('inputLinkLihat').value = '';
            document.getElementById('inputType1').value = 'EXCEL';
            document.getElementById('inputLink1').value = '';
            document.getElementById('inputTypePdf').value = 'PDF';
            document.getElementById('inputLinkPdf').value = '';

            document.getElementById('docModal').classList.remove('hidden');
        }

        function openEditDocModal(id) {
            renderSettingCategories();
            const doc = documents.find(d => d.id === String(id));
            if (!doc) return;

            document.getElementById('modalTitle').textContent = `Edit Dokumen`;
            document.getElementById('docId').value = doc.id;
            document.getElementById('inputNamaDoc').value = doc.nama;
            document.getElementById('inputKategoriDoc').value = doc.kategori;
            document.getElementById('inputLinkLihat').value = doc.linkLihat || '';
            document.getElementById('inputType1').value = doc.type1 || 'NONE';
            document.getElementById('inputLink1').value = doc.link1 || '';
            document.getElementById('inputTypePdf').value = doc.typePdf || 'NONE';
            document.getElementById('inputLinkPdf').value = doc.linkPdf || '';

            document.getElementById('docModal').classList.remove('hidden');
        }

        function closeDocModal() {
            document.getElementById('docModal').classList.add('hidden');
        }

        function handleDocFormSubmit(e) {
            e.preventDefault();

            const docId = document.getElementById('docId').value;
            const nama = document.getElementById('inputNamaDoc').value.trim();
            const kategori = document.getElementById('inputKategoriDoc').value;
            const linkLihat = document.getElementById('inputLinkLihat').value.trim();
            const type1 = document.getElementById('inputType1').value;
            const link1 = document.getElementById('inputLink1').value.trim();
            const typePdf = document.getElementById('inputTypePdf').value;
            const linkPdf = document.getElementById('inputLinkPdf').value.trim();

            if (!nama) {
                showToast('Nama dokumen wajib diisi', 'warning');
                return;
            }

            if (docId) {
                const index = documents.findIndex(d => d.id === String(docId));
                if (index !== -1) {
                    documents[index] = { id: docId, nama, kategori, linkLihat, type1, link1, typePdf, linkPdf };
                    showToast('Dokumen berhasil diperbarui', 'success');
                }
            } else {
                const newId = String(Date.now());
                documents.push({ id: newId, nama, kategori, linkLihat, type1, link1, typePdf, linkPdf });
                showToast('Dokumen baru berhasil ditambahkan', 'success');
            }

            saveToLocalStorage();
            renderSidebarMenu();
            renderSheetTable();
            renderSettingDocTable();
            closeDocModal();

            if (sheetUrl) {
                syncData(true);
            }
        }

        function confirmDeleteDoc(id) {
            const doc = documents.find(d => d.id === String(id));
            const docName = doc ? doc.nama : 'dokumen ini';

            showConfirmModal(
                'Hapus Dokumen',
                `Apakah Anda yakin ingin menghapus "${docName}"?`,
                () => {
                    documents = documents.filter(d => d.id !== String(id));
                    saveToLocalStorage();
                    renderSidebarMenu();
                    renderSheetTable();
                    renderSettingDocTable();
                    showToast('Dokumen berhasil dihapus', 'info');

                    if (sheetUrl) {
                        syncData(true);
                    }
                }
            );
        }

        function openAddSheetModal() {
            document.getElementById('inputModalNewSheet').value = '';
            document.getElementById('addSheetModal').classList.remove('hidden');
        }

        function closeAddSheetModal() {
            document.getElementById('addSheetModal').classList.add('hidden');
        }

        function saveNewSheetFromModal() {
            const val = document.getElementById('inputModalNewSheet').value.trim().toUpperCase();
            if (!val) {
                showToast('Nama sheet kategori wajib diisi', 'warning');
                return;
            }
            if (categories.includes(val)) {
                showToast('Kategori/Sheet ini sudah ada', 'warning');
                return;
            }

            categories.push(val);
            saveToLocalStorage();
            renderSidebarMenu();
            renderSettingCategories();
            closeAddSheetModal();
            showToast(`Sheet "${val}" berhasil ditambahkan`, 'success');
        }

        function addCategory() {
            const input = document.getElementById('newCategoryInput');
            const val = input.value.trim().toUpperCase();

            if (!val) {
                showToast('Nama sheet/kategori tidak boleh kosong', 'warning');
                return;
            }

            if (categories.includes(val)) {
                showToast('Kategori ini sudah ada', 'warning');
                return;
            }

            categories.push(val);
            input.value = '';
            saveToLocalStorage();
            renderSidebarMenu();
            renderSettingCategories();
            showToast(`Sheet "${val}" berhasil ditambahkan`, 'success');
        }

        function confirmDeleteCategory(categoryName) {
            const docCount = documents.filter(d => d.kategori === categoryName).length;
            
            showConfirmModal(
                'Hapus Sheet Kategori',
                `Apakah Anda yakin ingin menghapus kategori "${categoryName}"? (${docCount} dokumen terkait)`,
                () => {
                    categories = categories.filter(c => c !== categoryName);
                    saveToLocalStorage();
                    
                    if (activeSheet === categoryName && categories.length > 0) {
                        activeSheet = categories[0];
                    }

                    renderSidebarMenu();
                    renderSheetTable();
                    renderSettingCategories();
                    renderSettingDocTable();
                    showToast(`Kategori "${categoryName}" berhasil dihapus`, 'info');
                }
            );
        }

        function saveSheetConfig() {
            const url = document.getElementById('sheetUrlInput').value.trim();

            if (!url) {
                showToast('URL Google Apps Script belum diisi', 'warning');
                return;
            }

            sheetUrl = url;
            saveToLocalStorage();
            showToast('URL Google Apps Script disimpan', 'success');

            // Ambil data dari Google Sheet, jangan menimpa Sheet dengan data lokal
            loadDataFromSheet();
        }

        function loadDataFromSheet(silent = false) {
            if (!sheetUrl) {
                if (!silent) showToast('URL Google Apps Script belum diatur', 'warning');
                return;
            }

            const syncIcon = document.getElementById('sidebarSyncIcon');
            if (syncIcon) syncIcon.classList.add('animate-spin');

            updateConnectionBadgeStatus('syncing', 'Memuat data');

            fetch(sheetUrl)
                .then(res => {
                    if (!res.ok) throw new Error('HTTP ' + res.status);
                    return res.json();
                })
                .then(data => {
                    if (!Array.isArray(data)) {
                        throw new Error(data.message || 'Format data dari Google Sheet tidak sesuai');
                    }

                    documents = data;
                    saveToLocalStorage();

                    renderSidebarMenu();
                    renderSheetTable();
                    renderSettingCategories();
                    renderSettingDocTable();

                    updateConnectionBadgeStatus('connected', 'Tersambung API');

                    if (!silent) {
                        showToast(`Data berhasil dimuat dari Google Sheet (${data.length} dokumen)`, 'success');
                    }
                })
                .catch(err => {
                    updateConnectionBadgeStatus('error', 'Gagal Konek');
                    if (!silent) {
                        showToast('Gagal mengambil data dari Google Sheet: ' + err.message, 'error');
                    }
                })
                .finally(() => {
                    if (syncIcon) syncIcon.classList.remove('animate-spin');
                });
        }

        function testSheetConnection() {
            const url = document.getElementById('sheetUrlInput').value.trim();
            if (!url) {
                showToast('Harap masukkan URL Web App Apps Script terlebih dahulu', 'warning');
                return;
            }

            showToast('Menguji koneksi...', 'info');
            fetch(url)
                .then(res => res.json())
                .then(data => {
                    if (Array.isArray(data)) {
                        updateConnectionBadgeStatus('connected', 'Tersambung API');
                        showToast(`Koneksi berhasil! Ditemukan ${data.length} dokumen.`, 'success');
                    } else {
                        showToast('Respon Apps Script valid tetapi format tidak sesuai array.', 'warning');
                    }
                })
                .catch(err => {
                    updateConnectionBadgeStatus('error', 'Gagal Konek');
                    showToast('Gagal terhubung ke Google Apps Script', 'error');
                });
        }

        function syncData(silent = false) {
            if (!sheetUrl) {
                if (!silent) showToast('URL Google Apps Script belum diatur', 'warning');
                return;
            }

            const syncIcon = document.getElementById('sidebarSyncIcon');
            if (syncIcon) syncIcon.classList.add('animate-spin');

            updateConnectionBadgeStatus('syncing', 'Menyinkronkan');

            fetch(sheetUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'text/plain' },
                body: JSON.stringify(documents)
            })
            .then(res => res.json())
            .then(resData => {
                if (syncIcon) syncIcon.classList.remove('animate-spin');
                updateConnectionBadgeStatus('connected', 'Tersinkronisasi');
                if (!silent) showToast('Data berhasil disinkronkan ke Google Sheet', 'success');
            })
            .catch(err => {
                if (syncIcon) syncIcon.classList.remove('animate-spin');
                updateConnectionBadgeStatus('error', 'Sync Gagal');
                if (!silent) showToast('Sinkronisasi data gagal. Memakai data lokal.', 'error');
            });
        }

        function exportToExcel() {
            try {
                const exportData = documents.map((doc, idx) => ({
                    'No': idx + 1,
                    'Nama Dokument': doc.nama,
                    'Kategori / Unit Sheet': doc.kategori,
                    'Link Lihat': doc.linkLihat || '',
                    'Type 1': doc.type1,
                    'Link 1': doc.link1,
                    'Type PDF': doc.typePdf,
                    'Link PDF': doc.linkPdf
                }));

                const worksheet = XLSX.utils.json_to_sheet(exportData);
                const workbook = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(workbook, worksheet, activeSheet.substring(0, 30));

                XLSX.writeFile(workbook, `Puskesmas_Curugbitung_${activeSheet.replace(/\s+/g, '_')}.xlsx`);
                showToast('Sheet berhasil diekspor ke file Excel', 'success');
            } catch (err) {
                showToast('Gagal mengekspor data ke Excel', 'error');
            }
        }

        function toggleScriptGuideModal() {
            document.getElementById('guideModal').classList.toggle('hidden');
        }

        function copyScriptCode() {
            const code = document.getElementById('scriptCodeBlock').innerText;
            const textarea = document.createElement('textarea');
            textarea.value = code;
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            document.body.removeChild(textarea);

            const btnText = document.getElementById('copyBtnText');
            btnText.textContent = 'Tersalin!';
            setTimeout(() => { btnText.textContent = 'Salin Kode'; }, 2000);
            showToast('Kode Google Apps Script telah disalin ke clipboard', 'success');
        }

        function showToast(message, type = 'info') {
            const container = document.getElementById('toastContainer');
            if (!container) return;

            const toast = document.createElement('div');
            
            let bgClass = "bg-slate-800 text-white";
            let iconClass = "fa-solid fa-circle-info text-blue-400";

            if (type === 'success') {
                bgClass = "bg-emerald-900 text-emerald-50 border border-emerald-700";
                iconClass = "fa-solid fa-circle-check text-emerald-400";
            } else if (type === 'warning') {
                bgClass = "bg-amber-900 text-amber-50 border border-amber-700";
                iconClass = "fa-solid fa-triangle-exclamation text-amber-400";
            } else if (type === 'error') {
                bgClass = "bg-red-900 text-red-50 border border-red-700";
                iconClass = "fa-solid fa-circle-xmark text-red-400";
            }

            toast.className = `${bgClass} p-3 rounded-xl shadow-xl flex items-center space-x-3 text-xs font-medium pointer-events-auto transform transition-all duration-300 translate-y-2 opacity-0`;
            toast.innerHTML = `
                <i class="${iconClass} text-sm shrink-0"></i>
                <span class="flex-1">${escapeHtml(message)}</span>
            `;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => {
                    if (toast.parentNode) toast.parentNode.removeChild(toast);
                }, 300);
            }, 3000);
        }

        function showConfirmModal(title, message, onConfirm) {
            const modal = document.getElementById('confirmModal');
            document.getElementById('confirmTitle').textContent = title;
            document.getElementById('confirmMessage').textContent = message;

            const cancelBtn = document.getElementById('confirmCancelBtn');
            const okBtn = document.getElementById('confirmOkBtn');

            const cleanup = () => {
                modal.classList.add('hidden');
                cancelBtn.onclick = null;
                okBtn.onclick = null;
            };

            cancelBtn.onclick = () => cleanup();
            okBtn.onclick = () => {
                cleanup();
                if (typeof onConfirm === 'function') onConfirm();
            };

            modal.classList.remove('hidden');
        }

        function updateConnectionBadgeStatus(status, label) {
            const dot = document.getElementById('statusDot');
            const text = document.getElementById('statusText');
            const sidebarText = document.getElementById('sidebarSyncText');

            if (text) text.textContent = label;
            if (sidebarText) sidebarText.textContent = label;

            if (!dot) return;

            if (status === 'connected') {
                dot.className = "w-2.5 h-2.5 rounded-full bg-emerald-500";
            } else if (status === 'syncing') {
                dot.className = "w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping";
            } else if (status === 'error') {
                dot.className = "w-2.5 h-2.5 rounded-full bg-red-500";
            } else {
                dot.className = "w-2.5 h-2.5 rounded-full bg-slate-400";
            }
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }
    </script>
</body>
