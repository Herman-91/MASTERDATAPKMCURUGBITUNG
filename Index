                        btnFile1 = `<a href="${escapeHtml(doc.link1)}" target="_blank" class="inline-flex items-center justify-center min-w-[120px] px-3 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-[11px] font-semibold shadow transition active:scale-95">
                                        File Word / Dock
                                    </a>`;
                    }

                    // Tombol "Format Pdf" (Oranye)
                    let btnPdf = `<span class="text-slate-300">-</span>`;
                    if (doc.typePdf === 'PDF' && doc.linkPdf) {
                        btnPdf = `<a href="${escapeHtml(doc.linkPdf)}" target="_blank" class="inline-flex items-center justify-center w-20 px-3 py-1 bg-orange-500 hover:bg-orange-600 text-white rounded-lg text-[11px] font-semibold shadow transition active:scale-95">
                                      Pdf
                                  </a>`;
                    }

                    tr.innerHTML = `
                        <td class="py-2.5 px-3 text-center bg-slate-50 font-bold text-slate-500 border-r border-slate-200">${idx + 1}</td>
                        <td class="py-2.5 px-4 font-semibold text-slate-800 border-r border-slate-200">${escapeHtml(doc.nama)}</td>
                        <td class="py-2.5 px-4 text-slate-600 border-r border-slate-200">
                            <span class="px-2 py-0.5 bg-slate-100 text-slate-700 rounded border border-slate-200 text-[10px] font-semibold inline-block">
                                ${escapeHtml(doc.kategori)}
