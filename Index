        function renderSheetTable() {
            const tbody = document.getElementById('sheetTableBody');
            const emptyState = document.getElementById('emptySheetState');
            const searchVal = document.getElementById('searchInput') ? document.getElementById('searchInput').value.toLowerCase().trim() : '';

            if (!tbody) return;
            tbody.innerHTML = '';

            const filteredDocs = documents.filter(doc => {
                const matchSearch = doc.nama.toLowerCase().includes(searchVal);
                const matchCategory = (doc.kategori === activeSheet);
                return matchSearch && matchCategory;
            });

            if (filteredDocs.length === 0) {
                emptyState.classList.remove('hidden');
            } else {
                emptyState.classList.add('hidden');

                filteredDocs.forEach((doc, idx) => {
                    const tr = document.createElement('tr');
                    tr.className = "hover:bg-emerald-50/40 transition border-b border-slate-200";

