                        <td class="py-2.5 px-3 text-center border-r border-slate-200">${btnFile1}</td>
                        <td class="py-2.5 px-3 text-center">${btnPdf}</td>
                    `;
                    tbody.appendChild(tr);
                });
            }
        }

        function renderSettingCategories() {
            const badgeList = document.getElementById('categoryBadgeList');
            const modalDropdown = document.getElementById('inputKategoriDoc');
            const settingFilterDropdown = document.getElementById('settingCategoryFilter');

            if (!badgeList || !modalDropdown) return;

            badgeList.innerHTML = '';
            modalDropdown.innerHTML = '';
            
            if (settingFilterDropdown) {
                const currentFilter = settingFilterDropdown.value || 'ALL';
                settingFilterDropdown.innerHTML = `<option value="ALL">Semua Kategori Sheet</option>`;
                categories.forEach(cat => {
                    const optFilter = document.createElement('option');
                    optFilter.value = cat;
                    optFilter.textContent = cat;
                    settingFilterDropdown.appendChild(optFilter);
                });
                settingFilterDropdown.value = currentFilter;
            }

            categories.forEach(cat => {
                const badge = document.createElement('div');
                badge.className = "inline-flex items-center gap-1.5 bg-slate-100 text-slate-700 px-2.5 py-1 rounded-lg text-xs font-semibold border border-slate-200";
