<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistem Manajemen Dokumen UPTD PUSKESMAS CURUGBITUNG</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- SheetJS for Excel generation -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        excel: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                        },
                        dock: {
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8'
                        },
                        pdf: {
                            500: '#f97316',
                            600: '#ea580c',
                            700: '#c2410c'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .grid-line-table th, .grid-line-table td {
            border: 1px solid #e2e8f0;
        }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
        
        .tree-line {
            position: relative;
        }
        .tree-line::before {
            content: '';
            position: absolute;
            left: 18px;
            top: 0;
            bottom: 0;
            width: 1.5px;
            background-color: #cbd5e1;
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 min-h-screen flex flex-col md:flex-row overflow-x-hidden">

    <!-- Toast Notification Container -->
    <div id="toastContainer" class="fixed top-5 right-5 z-50 flex flex-col gap-2 max-w-sm pointer-events-none"></div>

    <!-- Sidebar Navigation -->
    <aside id="sidebar" class="w-72 bg-white border-r border-slate-200 flex flex-col shrink-0 fixed md:static inset-y-0 left-0 z-40 transform -translate-x-full md:translate-x-0 transition-transform duration-300 shadow-lg md:shadow-none">
        
        <!-- Sidebar Brand Header -->
        <div class="p-4 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 bg-emerald-600 rounded-xl flex items-center justify-center font-bold text-xl text-white shadow-md shadow-emerald-600/30">
                    <i class="fa-solid fa-hospital"></i>
                </div>
                <div>
                    <h1 class="font-bold text-sm text-slate-800 leading-tight">PUSKESMAS</h1>
                    <p class="text-xs font-semibold text-emerald-600">CURUGBITUNG</p>
                </div>
            </div>
            <button onclick="toggleMobileSidebar()" class="md:hidden text-slate-400 hover:text-slate-600 p-1">
                <i class="fa-solid fa-xmark text-lg"></i>
            </button>
        </div>

        <!-- Sidebar Navigation Items -->
        <div class="flex-1 overflow-y-auto px-3 py-4 space-y-1">
            
            <!-- Sheet Units Menu Accordion Header -->
            <div class="pt-1">
                <button onclick="toggleUnitMenuAccordion()" 
                        class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-bold text-slate-800 bg-slate-50 hover:bg-slate-100 transition">
                    <div class="flex items-center space-x-3">
                        <i class="fa-solid fa-folder-tree text-emerald-600"></i>
                        <span>Menu Kategori Dokumen</span>
                    </div>
                    <i id="accordionIcon" class="fa-solid fa-minus text-xs text-slate-400 transition-transform"></i>
                </button>

                <!-- Accordion Submenu Links (Tree Style) -->
                <div id="unitMenuContainer" class="pl-4 pt-1 space-y-1 tree-line">
                    <div id="unitSheetList" class="space-y-0.5">
                        <!-- Dynamic Sheet links injected here via JS -->
                    </div>
                </div>
            </div>

            <!-- Settings & Connection Navigation -->
            <div class="pt-4 border-t border-slate-100">
                <div class="text-[11px] font-bold text-slate-400 px-3 uppercase tracking-wider mb-1">Pengaturan</div>
                <button id="navSetting" onclick="switchView('setting')" 
                        class="w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-sm font-semibold text-slate-700 hover:bg-slate-100 transition group">
                    <div class="flex items-center space-x-3">
                        <i class="fa-solid fa-gear text-slate-500 group-hover:text-emerald-600"></i>
                        <span>Seting & Sync API</span>
                    </div>
                    <i class="fa-solid fa-angle-right text-xs text-slate-300"></i>
                </button>
            </div>

        </div>

        <!-- Sidebar Footer Banner -->
        <div class="p-3 m-3 bg-emerald-50 rounded-xl border border-emerald-100 text-xs">
            <div class="flex items-center gap-2 font-bold text-emerald-800 mb-1">
                <i class="fa-solid fa-circle-check text-emerald-600"></i>
                <span>Status Google Sheet</span>
            </div>
            <p class="text-slate-600 text-[11px] leading-tight mb-2" id="sidebarSyncText">Tersambung Lokal</p>
            <button onclick="loadDataFromSheet()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-1.5 rounded-lg font-semibold text-xs transition shadow-sm flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-rotate text-[10px]" id="sidebarSyncIcon"></i>
                <span>Sync Data Now</span>
            </button>
        </div>

    </aside>

    <!-- Overlay for mobile sidebar -->
    <div id="mobileOverlay" onclick="toggleMobileSidebar()" class="fixed inset-0 bg-slate-900/40 z-30 hidden md:hidden"></div>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-w-0 h-screen overflow-y-auto">

        <!-- Top Header Navigation Bar -->
        <header class="bg-white border-b border-slate-200 sticky top-0 z-20 px-4 py-3 flex items-center justify-between gap-4 shadow-sm">
            <div class="flex items-center space-x-3">
                <button onclick="toggleMobileSidebar()" class="md:hidden text-slate-600 hover:text-slate-900 p-1 rounded-lg hover:bg-slate-100">
                    <i class="fa-solid fa-bars text-lg"></i>
                </button>
                <div>
                    <div class="flex items-center gap-2">
                        <span id="headerSheetTag" class="text-xs px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 font-bold uppercase">MENU DOKUMEN</span>
                        <h2 id="headerTitle" class="font-bold text-slate-800 text-base md:text-lg">DASHBOARD ILP</h2>
                    </div>
                    <p class="text-xs text-slate-500 hidden sm:block">Kelola & Akses Berkas Excel, Word, dan PDF UPTD Puskesmas Curugbitung</p>
                </div>
            </div>

            <div class="flex items-center space-x-2">
                <!-- Global Sync Badge -->
                <div id="connectionBadge" class="hidden sm:flex items-center space-x-2 bg-slate-100 px-3 py-1.5 rounded-lg text-xs font-medium border border-slate-200">
                    <span class="w-2.5 h-2.5 rounded-full bg-amber-400 animate-pulse" id="statusDot"></span>
                    <span id="statusText" class="text-slate-700">Lokal</span>
                </div>

                <!-- Export Excel Button -->
                <button onclick="exportToExcel()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3 py-2 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition shadow-sm active:scale-95">
                    <i class="fa-solid fa-file-excel"></i>
                    <span class="hidden sm:inline">Ekspor Sheet</span>
                </button>
            </div>
        </header>

        <!-- Main Workspace Container -->
        <main class="p-3 sm:p-6 flex-grow space-y-4">

            <!-- PAGE 1: SHEET / DASHBOARD DATA VIEW -->
            <div id="viewSheetData" class="space-y-4">

                <!-- Controls & Filtering Bar -->
                <div class="bg-white p-3 rounded-xl border border-slate-200 shadow-sm flex flex-col md:flex-row gap-3 items-center justify-between">
                    <!-- Search Input -->
                    <div class="relative w-full md:w-80">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                        <input type="text" id="searchInput" oninput="renderSheetTable()" placeholder="Cari dalam sheet ini..." 
                               class="w-full pl-8 pr-3 py-2 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition">
                    </div>
                    <div class="text-xs text-slate-500 font-medium hidden sm:block">
                        <i class="fa-solid fa-circle-info text-emerald-600 mr-1"></i>
                        Pilih menu sheet di sebelah kiri untuk melihat daftar dokumen
                    </div>
                </div>

                <!-- Spreadsheet Grid Table Container -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
                    <div class="overflow-x-auto overflow-y-auto max-h-[560px] w-full">
                        <table class="w-full text-left border-collapse grid-line-table">
                            <thead class="bg-slate-50 text-slate-700 text-xs font-semibold uppercase sticky top-0 z-10 shadow-sm">
                                <tr>
                                    <th class="py-2.5 px-3 text-center w-12 bg-slate-100" rowspan="2">No</th>
                                    <th class="py-2.5 px-4 min-w-[240px]" rowspan="2">Nama Dokument</th>
                                    <th class="py-2.5 px-4 w-44" rowspan="2">Kategori / Unit Sheet</th>
                                    <th colspan="3" class="py-2 px-4 text-center border-b border-slate-300 bg-slate-100 font-bold">Link Berkas</th>
                                </tr>
                                <tr class="bg-slate-100 text-slate-600 text-[11px] font-medium border-t border-slate-200 sticky top-[37px] z-10">
                                    <th class="py-1.5 px-3 text-center w-28 border-r border-slate-300">Lihat</th>
                                    <th class="py-1.5 px-3 text-center w-44 border-r border-slate-300">Format Dock / Excel</th>
                                    <th class="py-1.5 px-3 text-center w-32">Format Pdf</th>
                                </tr>
                            </thead>
                            <tbody id="sheetTableBody" class="text-xs font-medium text-slate-800 divide-y divide-slate-200 bg-white">
                                <!-- Data rows injected via JS -->
                            </tbody>
                        </table>
                    </div>

                    <!-- Empty State View -->
                    <div id="emptySheetState" class="hidden p-12 text-center text-slate-500">
                        <i class="fa-regular fa-folder-open text-5xl mb-3 text-slate-300"></i>
                        <p class="font-semibold text-slate-700 text-sm">Tidak ada dokumen di sheet ini</p>
                        <p class="text-xs text-slate-400 mt-1">Untuk menambah atau mengelola dokumen, buka menu <span class="font-semibold text-emerald-600">"Seting & Sync API"</span>.</p>
                    </div>
                </div>

            </div>

            <!-- PAGE 2: SETTINGS & CONFIGURATION -->
            <div id="viewSetting" class="hidden space-y-6">
                
                <!-- Google Sheet API Link Card -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 sm:p-5">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
                        <div class="flex items-center space-x-2">
                            <i class="fa-solid fa-link text-emerald-600 text-lg"></i>
                            <h3 class="font-bold text-slate-800 text-sm md:text-base">Pengaturan Integrasi Google Spreadsheet API</h3>
                        </div>
                        <button onclick="toggleScriptGuideModal()" class="text-xs font-semibold text-emerald-600 hover:text-emerald-700 bg-emerald-50 border border-emerald-200 px-3 py-1.5 rounded-lg transition flex items-center gap-1.5">
                            <i class="fa-regular fa-circle-question"></i>
                            <span>Panduan Apps Script</span>
                        </button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 items-end">
                        <div class="md:col-span-2 space-y-1.5">
                            <label class="text-xs font-semibold text-slate-600 block">URL Apps Script Web App Endpoint</label>
                            <input type="url" id="sheetUrlInput" placeholder="https://script.google.com/macros/s/AKfycbzZakeizaYDHgFtboWrLnDTd-m6Jq_wVgYKnRD-5njeSeiWi0L_Af4EHThzLF7ZyxA3/exec" 
                                   class="w-full px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:bg-white transition">
                            <p class="text-[11px] text-slate-400">Tempelkan Web App URL yang dipublikasikan dari Apps Script untuk otomatis menyinkronkan data secara 2-arah.</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <button onclick="saveSheetConfig()" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg text-xs font-semibold transition shadow-sm flex items-center justify-center gap-2 active:scale-95">
                                <i class="fa-solid fa-floppy-disk"></i>
                                <span>Simpan URL</span>
                            </button>
                            <button onclick="testSheetConnection()" class="bg-slate-100 hover:bg-slate-200 text-slate-700 border border-slate-300 px-3 py-2 rounded-lg text-xs font-semibold transition flex items-center gap-1.5 active:scale-95">
                                <i class="fa-solid fa-plug"></i>
                                <span>Tes Koneksi</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Sheet Units Management Card -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 sm:p-5">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
                        <div>
                            <h3 class="font-bold text-slate-800 text-sm flex items-center gap-2">
                                <i class="fa-solid fa-tags text-emerald-600"></i>
                                <span>Kelola Menu / Kategori Sheet Puskesmas</span>
                            </h3>
                            <p class="text-xs text-slate-500 mt-0.5">Tambah, ubah, atau hapus menu kategori yang tampil pada sidebar navigasi.</p>
                        </div>
                    </div>

                    <div class="flex flex-wrap items-center gap-2 mb-4" id="categoryBadgeList">
                        <!-- Category badges injected via JS -->
                    </div>

                    <div class="flex items-center gap-2 max-w-md">
                        <input type="text" id="newCategoryInput" placeholder="Ketik nama menu/kategori baru (cth: REKAM MEDIS)" 
                               class="flex-1 px-3 py-2 text-xs bg-slate-50 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500">
                        <button onclick="addCategory()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-lg text-xs font-bold transition shadow-sm flex items-center gap-1.5 active:scale-95 shrink-0">
                            <i class="fa-solid fa-plus text-[10px]"></i>
                            <span>Tambah Menu</span>
                        </button>
                    </div>
                </div>

                <!-- Document Management Card (Tambah & Aksi Dokumen) -->
                <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4 sm:p-5 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-100 pb-3">
                        <div>
                            <h3 class="font-bold text-slate-800 text-sm md:text-base flex items-center gap-2">
                                <i class="fa-solid fa-file-pen text-emerald-600"></i>
                                <span>Kelola Data Dokumen & Menu Aksi</span>
                            </h3>
                            <p class="text-xs text-slate-500 mt-0.5">Tambah, edit, atau hapus dokumen yang terdaftar di portal.</p>
                        </div>
                        <button onclick="openAddDocModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-3.5 py-2 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition shadow-sm active:scale-95 shrink-0 self-start sm:self-auto">
                            <i class="fa-solid fa-plus"></i>
                            <span>+ Tambah Dokumen Baru</span>
                        </button>
                    </div>

                    <!-- Filter & Search for Settings Document Table -->
                    <div class="flex flex-col md:flex-row gap-3 items-center justify-between">
                        <div class="relative w-full md:w-72">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                            <input type="text" id="settingSearchInput" oninput="renderSettingDocTable()" placeholder="Cari nama/kategori dokumen..." 
                                   class="w-full pl-8 pr-3 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500">
                        </div>
                        <div class="flex items-center gap-2 w-full md:w-auto">
                            <label class="text-xs text-slate-500 font-medium whitespace-nowrap">Filter Sheet:</label>
                            <select id="settingCategoryFilter" onchange="renderSettingDocTable()" class="w-full md:w-56 px-2.5 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500">
                                <option value="ALL">Semua Kategori Sheet</option>
                            </select>
                        </div>
                    </div>

                    <!-- Document Table in Settings View with Aksi Column -->
                    <div class="border border-slate-200 rounded-xl overflow-hidden">
                        <div class="overflow-x-auto max-h-[400px]">
                            <table class="w-full text-left border-collapse grid-line-table">
                                <thead class="bg-slate-50 text-slate-700 text-xs font-semibold uppercase sticky top-0 z-10">
                                    <tr>
                                        <th class="py-2.5 px-3 text-center w-12 bg-slate-100">No</th>
                                        <th class="py-2.5 px-4 min-w-[200px]">Nama Dokumen</th>
                                        <th class="py-2.5 px-4 w-40">Kategori / Sheet</th>
                                        <th class="py-2.5 px-4 text-center w-36">Status Link</th>
                                        <th class="py-2.5 px-4 text-center w-28">Menu Aksi</th>
                                    </tr>
                                </thead>
                                <tbody id="settingDocTableBody" class="text-xs font-medium text-slate-800 divide-y divide-slate-200 bg-white">
                                    <!-- Injected via JS -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

        </main>
    </div>

    <!-- Add / Edit Document Modal -->
    <div id="docModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl border border-slate-100 transform transition-all">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
                <h3 id="modalTitle" class="font-bold text-slate-800 text-base">Tambah Dokumen Baru</h3>
                <button onclick="closeDocModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold p-1">&times;</button>
            </div>

            <form id="docForm" onsubmit="handleDocFormSubmit(event)" class="space-y-4">
                <input type="hidden" id="docId">

                <div>
                    <label class="text-xs font-semibold text-slate-700 block mb-1">Nama Dokumen *</label>
                    <input type="text" id="inputNamaDoc" required placeholder="Contoh: SK Kepala Puskesmas 2026" 
                           class="w-full px-3 py-2 text-xs border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                </div>

                <div>
                    <label class="text-xs font-semibold text-slate-700 block mb-1">Kategori / Unit Sheet *</label>
                    <select id="inputKategoriDoc" required class="w-full px-3 py-2 text-xs border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                        <!-- Populated dynamically -->
                    </select>
                </div>

                <div class="pt-2 border-t border-slate-100">
                    <label class="text-xs font-semibold text-amber-800 block mb-1">URL Link Lihat (Preview / Akses Langsung)</label>
                    <input type="text" id="inputLinkLihat" placeholder="https://drive.google.com/file/d/..." 
                           class="w-full px-3 py-2 text-xs border border-amber-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:outline-none bg-amber-50/40">
                    <p class="text-[11px] text-slate-500 mt-1">
                        <i class="fa-solid fa-circle-info text-amber-600 mr-0.5"></i>
                        URL khusus tombol <span class="font-bold text-amber-700">"Lihat"</span>. Jika dikosongkan, otomatis mengambil dari Link File 1 atau PDF.
                    </p>
                </div>

                <div class="grid grid-cols-2 gap-3 pt-2 border-t border-slate-100">
                    <div>
                        <label class="text-xs font-semibold text-slate-700 block mb-1">Format File 1</label>
                        <select id="inputType1" class="w-full px-3 py-2 text-xs border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                            <option value="EXCEL">EXCEL (Hijau)</option>
                            <option value="Dock">Dock (Biru)</option>
                            <option value="NONE">Tidak Ada</option>
                        </select>
                    </div>

                    <div>
                        <label class="text-xs font-semibold text-slate-700 block mb-1">URL Link File 1</label>
                        <input type="text" id="inputLink1" placeholder="https://drive.google.com/..." 
                               class="w-full px-3 py-2 text-xs border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="text-xs font-semibold text-slate-700 block mb-1">Format File PDF</label>
                        <select id="inputTypePdf" class="w-full px-3 py-2 text-xs border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                            <option value="PDF">PDF (Oranye)</option>
                            <option value="NONE">Tidak Ada</option>
                        </select>
                    </div>

                    <div>
                        <label class="text-xs font-semibold text-slate-700 block mb-1">URL Link File PDF</label>
                        <input type="text" id="inputLinkPdf" placeholder="https://drive.google.com/..." 
                               class="w-full px-3 py-2 text-xs border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-500 focus:outline-none">
                    </div>
                </div>

                <div class="flex items-center justify-end space-x-2 pt-4 border-t border-slate-100">
                    <button type="button" onclick="closeDocModal()" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:bg-slate-100 rounded-lg transition">
                        Batal
                    </button>
                    <button type="submit" class="px-5 py-2 text-xs font-bold text-white bg-emerald-600 hover:bg-emerald-700 rounded-lg transition shadow-md active:scale-95">
                        Simpan Data
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Add New Sheet Modal -->
    <div id="addSheetModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl border border-slate-100">
            <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
                <h3 class="font-bold text-slate-800 text-base">Tambah Sheet Kategori Baru</h3>
                <button onclick="closeAddSheetModal()" class="text-slate-400 hover:text-slate-600 text-xl font-bold">&times;</button>
            </div>
            <div class="space-y-4">
                <div>
