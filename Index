                    <button onclick="confirmDeleteCategory('${escapeHtml(cat)}')" class="text-slate-400 hover:text-red-500 text-xs font-bold ml-1">&times;</button>
                `;
                badgeList.appendChild(badge);

                const optModal = document.createElement('option');
                optModal.value = cat;
                optModal.textContent = cat;
                modalDropdown.appendChild(optModal);
            });
        }

        function renderSettingDocTable() {
            const tbody = document.getElementById('settingDocTableBody');
            if (!tbody) return;

            const searchVal = document.getElementById('settingSearchInput') ? document.getElementById('settingSearchInput').value.toLowerCase().trim() : '';
            const categoryVal = document.getElementById('settingCategoryFilter') ? document.getElementById('settingCategoryFilter').value : 'ALL';

            tbody.innerHTML = '';

            const filteredDocs = documents.filter(doc => {
                const matchSearch = doc.nama.toLowerCase().includes(searchVal) || doc.kategori.toLowerCase().includes(searchVal);
                const matchCategory = (categoryVal === 'ALL' || doc.kategori === categoryVal);
                return matchSearch && matchCategory;
            });

            if (filteredDocs.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" class="py-8 text-center text-slate-400 font-normal">Tidak ada dokumen ditemukan</td></tr>`;
                return;
            }

            filteredDocs.forEach((doc, idx) => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-emerald-50/30 transition border-b border-slate-200";

                let statusBadges = [];
                if (doc.linkLihat || doc.link1 || doc.linkPdf) statusBadges.push(`<span class="px-1.5 py-0.5 bg-amber-100 text-amber-800 rounded text-[10px] font-bold">Lihat</span>`);
                if (doc.type1 === 'EXCEL' && doc.link1) statusBadges.push(`<span class="px-1.5 py-0.5 bg-emerald-100 text-emerald-800 rounded text-[10px] font-bold">Excel</span>`);
                if (doc.type1 === 'Dock' && doc.link1) statusBadges.push(`<span class="px-1.5 py-0.5 bg-blue-100 text-blue-800 rounded text-[10px] font-bold">Word</span>`);
                if (doc.typePdf === 'PDF' && doc.linkPdf) statusBadges.push(`<span class="px-1.5 py-0.5 bg-orange-100 text-orange-800 rounded text-[10px] font-bold">PDF</span>`);

                tr.innerHTML = `
                    <td class="py-2.5 px-3 text-center bg-slate-50 font-bold text-slate-500 border-r border-slate-200">${idx + 1}</td>
                    <td class="py-2.5 px-4 font-semibold text-slate-800 border-r border-slate-200">${escapeHtml(doc.nama)}</td>
